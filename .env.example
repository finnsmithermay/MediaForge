# Server
PORT=8080

# AWS (leave AWS_ENDPOINT empty for real AWS)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566

# S3
S3_BUCKET=mediaforge-uploads

# DynamoDB
DYNAMODB_TABLE=mediaforge-jobs

# SQS
SQS_QUEUE_URL=http://localhost:4566/000000000000/mediaforge-jobs

# Workers
WORKER_COUNT=3
WORKER_BUFFER=10
